#!/usr/bin/env python3
"""Backend for cross-folder Claude Code session browsing.

Usage:
  claude-session-index list            # TSV: display \t filepath \t sessionid \t cwd
  claude-session-index preview <file>  # human-readable preview of a transcript
"""
import json
import os
import sys
import time
import glob
import signal

# behave like a normal unix filter when piped into head/less etc.
try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

PROJECTS = os.path.expanduser("~/.claude/projects")


def reltime(epoch):
    d = time.time() - epoch
    if d < 90:
        return f"{int(d)}s ago"
    if d < 5400:
        return f"{int(d/60)}m ago"
    if d < 129600:
        return f"{int(d/3600)}h ago"
    return f"{int(d/86400)}d ago"


def short_cwd(cwd):
    home = os.path.expanduser("~")
    if cwd == home:
        return "~"
    if cwd.startswith(home + "/"):
        return "~/" + cwd[len(home) + 1:]
    return cwd


def text_of(content):
    """Return plain text from a user/assistant message content field."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text":
                parts.append(b.get("text", ""))
        return " ".join(parts)
    return ""


def is_real_user_text(t):
    if not t:
        return False
    t = t.strip()
    if not t:
        return False
    if t.startswith("<"):            # <command-name>, <system-reminder>, <local-command-stdout>...
        return False
    if t.startswith("Caveat:"):
        return False
    return True


def scan_head(path, max_lines=60):
    """Read the head of a transcript; return (cwd, title)."""
    cwd = ""
    title = ""
    try:
        with open(path, "r", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > max_lines and cwd and title:
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if not cwd and d.get("cwd"):
                    cwd = d["cwd"]
                if not title and d.get("type") == "user" and not d.get("isMeta"):
                    t = text_of(d.get("message", {}).get("content"))
                    if is_real_user_text(t):
                        title = " ".join(t.split())[:110]
    except Exception:
        pass
    return cwd, title


def cmd_list():
    rows = []
    for path in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        # skip subagent transcripts (they live in .../<id>/subagents/)
        if os.sep + "subagents" + os.sep in path:
            continue
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        cwd, title = scan_head(path)
        if not title:
            title = "(no user message)"
        sid = os.path.basename(path)[:-6]  # strip .jsonl
        rows.append((mtime, path, sid, cwd or "?", title))
    rows.sort(key=lambda r: r[0], reverse=True)
    for mtime, path, sid, cwd, title in rows:
        display = f"{reltime(mtime):>8}  {short_cwd(cwd):<24.24}  {title}"
        sys.stdout.write(f"{display}\t{path}\t{sid}\t{cwd}\n")


def cmd_preview(path):
    cwd, title = scan_head(path)
    print(f"\033[1mfolder:\033[0m {cwd}")
    print(f"\033[1mtitle :\033[0m {title}\n")
    # last few text exchanges
    msgs = []
    try:
        with open(path, "r", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("isMeta"):
                    continue
                typ = d.get("type")
                if typ not in ("user", "assistant"):
                    continue
                t = text_of(d.get("message", {}).get("content"))
                t = " ".join(t.split())
                if not t or t.startswith("<") or t.startswith("Caveat:"):
                    continue
                msgs.append((typ, t[:400]))
    except Exception:
        pass
    for typ, t in msgs[-8:]:
        tag = "\033[36myou\033[0m" if typ == "user" else "\033[33mclaude\033[0m"
        print(f"{tag}: {t}\n")


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "list":
        cmd_list()
    elif len(sys.argv) >= 3 and sys.argv[1] == "preview":
        cmd_preview(sys.argv[2])
    else:
        sys.stderr.write(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        os._exit(0)
